# Configuración de base de datos para Docker
DB_USER=sildemar
DB_PASS=sildemar_pass
DB_NAME=sildemar
MYSQL_ROOT_PASSWORD=rootpass
# Mail / SMTP (opcional)
MAIL_DEBUG=1
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
